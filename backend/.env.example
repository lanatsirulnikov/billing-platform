APP_ENV=development
APP_NAME=billing-platform-api
APP_PORT=8000

POSTGRES_DB=billing_platform
POSTGRES_USER=billing_user
POSTGRES_PASSWORD=billing_password

# Local non-Docker default:
DATABASE_URL=mysql+pymysql://billing_user:billing_password@localhost:3306/billing_platform

# Docker Compose uses:
# DATABASE_URL=postgresql+psycopg://billing_user:billing_password@db:5432/billing_platform

LOG_LEVEL=INFO